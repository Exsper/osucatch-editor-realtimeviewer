<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <RootNamespace>osucatch_editor_realtimeviewer</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK" Version="3.3.3" />
    <PackageReference Include="OpenTK.GLControl" Version="3.3.3" />
    <PackageReference Include="System.Numerics.Tensors" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="app.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>app.settings</DependentUpon>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="app.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>app.Designer.cs</LastGenOutput>
    </None>
    <None Update="img\fruit-apple.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="img\fruit-bananas.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="img\fruit-drop.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Osu.Game\" />
  </ItemGroup>

  <PropertyGroup>
    <!-- win-x64/win-x86 构建使用对应位数原生库；未指定 RID 的调试构建默认按 64 位（AnyCPU 在 x64 系统上以 64 位进程运行） -->
    <StableCompatLibSourceDir Condition="'$(RuntimeIdentifier)' == 'win-x64'">$(MSBuildProjectDirectory)\..\StableCompatLib\x64</StableCompatLibSourceDir>
    <StableCompatLibSourceDir Condition="'$(RuntimeIdentifier)' == 'win-x86'">$(MSBuildProjectDirectory)\..\StableCompatLib\x86</StableCompatLibSourceDir>
    <StableCompatLibSourceDir Condition="'$(StableCompatLibSourceDir)' == ''">$(MSBuildProjectDirectory)\..\StableCompatLib\x64</StableCompatLibSourceDir>
  </PropertyGroup>

  <Target Name="CopyStableCompatLib" AfterTargets="Build">
    <Warning Condition="'$(RuntimeIdentifier)' == ''"
             Text="未指定 RuntimeIdentifier，默认复制 64 位 StableCompatLib；如需 32 位请用 -r win-x86 构建。" />
    <Error Condition="!Exists('$(StableCompatLibSourceDir)\StableCompatLib.dll')"
           Text="找不到 $(StableCompatLibSourceDir)\StableCompatLib.dll，请先构建对应架构的 StableCompatLib（CI 中由 MSYS2 步骤生成）。" />
    <Copy SourceFiles="$(StableCompatLibSourceDir)\StableCompatLib.dll"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <RootNamespace>osucatch_editor_realtimeviewer</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      编辑器内存读取实现的选择开关。

      新版（默认）：当前 EditorReader/*.cs，带指针位宽修正、跨页分段读取、扫描诊断等改进。
      旧版：EditorReaderLegacy/*.legacy，即 1564fdc 的原版实现，用于 Wine 等兼容性优先的场景。

      用法：
        dotnet build                                  -> 新版
        dotnet build -p:UseLegacyEditorReader=true    -> 旧版
      两份实现提供完全相同的公开 API，调用方（EditorReaderHelper / Form1）无需改动。
    -->
    <UseLegacyEditorReader Condition="'$(UseLegacyEditorReader)' == ''">false</UseLegacyEditorReader>

    <!--
      只保留真正需要“关掉”的警告，其余一律修代码（见各处的注释）：

      CS8981：类型名 "app" 全是小写。它是 app.settings 生成的 WinForms 设置类，
              改名要牵动全项目几百处 app.Default，代价远大于收益，故在此抑制。
      NU1701：OpenTK / OpenTK.GLControl 3.3.3 只发布了 .NET Framework 版本，
              NuGet 会提示“按 .NETFramework 还原、可能与 net8.0 不兼容”。
              这是有意为之（靠 .NET 的兼容层跑 OpenGL 控件），
              真要消除只能迁移到 OpenTK 4.x，属于单独的大改动。

      说明：NU1900（取不到番外漏洞数据）不在这里抑制，改用下面的 NuGetAudit 关闭——
            离线环境本来也取不到数据，关掉后连网络请求都不再发起。
    -->
    <NoWarn>$(NoWarn);CS8981;NU1701</NoWarn>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK" Version="3.3.3" />
    <PackageReference Include="OpenTK.GLControl" Version="3.3.3" />
    <PackageReference Include="System.Numerics.Tensors" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="app.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>app.settings</DependentUpon>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="app.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>app.Designer.cs</LastGenOutput>
    </None>
    <None Update="img\fruit-apple.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="img\fruit-bananas.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="img\fruit-drop.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 快捷开关栏按钮图标：16x16 透明 PNG，按程序所在目录下的 icons\ 读取 -->
    <None Update="icons\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Osu.Game\" />
  </ItemGroup>

  <!--
    编辑器读取实现二选一。两份都在 Editor_Reader 命名空间下提供同名的
    EditorReader / Internals / HitObject / ControlPoint，因此必须只编译其中一份。
    *.legacy 不是默认的 .cs 扩展名，所以不会被 SDK 自动包含；只有开启开关时才显式加入。
  -->
  <ItemGroup Condition="'$(UseLegacyEditorReader)' != 'true'">
    <Compile Remove="EditorReaderLegacy\**\*.legacy" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLegacyEditorReader)' == 'true'">
    <Compile Remove="EditorReader\EditorReader.cs" />
    <Compile Remove="EditorReader\Internals.cs" />
    <Compile Remove="EditorReader\HitObject.cs" />
    <Compile Remove="EditorReader\ControlPoint.cs" />
    <Compile Include="EditorReaderLegacy\EditorReader.cs.legacy">
      <Link>EditorReader\EditorReader.cs</Link>
    </Compile>
    <Compile Include="EditorReaderLegacy\Internals.cs.legacy">
      <Link>EditorReader\Internals.cs</Link>
    </Compile>
    <Compile Include="EditorReaderLegacy\HitObject.cs.legacy">
      <Link>EditorReader\HitObject.cs</Link>
    </Compile>
    <Compile Include="EditorReaderLegacy\ControlPoint.cs.legacy">
      <Link>EditorReader\ControlPoint.cs</Link>
    </Compile>
  </ItemGroup>

  <!-- 编译期常量，便于代码里区分实现（也用于在日志里标注当前用的是哪一份） -->
  <PropertyGroup Condition="'$(UseLegacyEditorReader)' == 'true'">
    <DefineConstants>$(DefineConstants);LEGACY_EDITOR_READER</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <!-- win-x64/win-x86 构建使用对应位数原生库；未指定 RID 的调试构建默认按 64 位（AnyCPU 在 x64 系统上以 64 位进程运行） -->
    <StableCompatLibSourceDir Condition="'$(RuntimeIdentifier)' == 'win-x64'">$(MSBuildProjectDirectory)\..\StableCompatLib\x64</StableCompatLibSourceDir>
    <StableCompatLibSourceDir Condition="'$(RuntimeIdentifier)' == 'win-x86'">$(MSBuildProjectDirectory)\..\StableCompatLib\x86</StableCompatLibSourceDir>
    <StableCompatLibSourceDir Condition="'$(StableCompatLibSourceDir)' == ''">$(MSBuildProjectDirectory)\..\StableCompatLib\x64</StableCompatLibSourceDir>
  </PropertyGroup>

  <Target Name="CopyStableCompatLib" AfterTargets="Build">
    <!-- 这只是“没指定架构，默认按 64 位复制”的提示，不是错误；用 Message 输出，
         既不污染 warning 计数，也仍然会出现在构建日志里 -->
    <Message Condition="'$(RuntimeIdentifier)' == ''" Importance="high"
             Text="未指定 RuntimeIdentifier，默认复制 64 位 StableCompatLib；如需 32 位请用 -r win-x86 构建。" />
    <Error Condition="!Exists('$(StableCompatLibSourceDir)\StableCompatLib.dll')"
           Text="找不到 $(StableCompatLibSourceDir)\StableCompatLib.dll，请先构建对应架构的 StableCompatLib（CI 中由 MSYS2 步骤生成）。" />
    <Copy SourceFiles="$(StableCompatLibSourceDir)\StableCompatLib.dll"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
